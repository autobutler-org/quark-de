# Quark DE: Quark is the desktop. A browser and a terminal live on side workspaces.

set $mod Mod4
set $quark 1:quark
set $browser 2:browser
set $terminal 3:terminal
set $share /usr/local/share/quark-de

# No bar, no decorations: Quark draws the whole screen.
default_border none
default_floating_border none
gaps inner 0
gaps outer 0

# App IDs: Quark's Flutter APPLICATION_ID (quark/linux/CMakeLists.txt), firefox, foot.
assign [app_id="org.autobutler.quark"] workspace $quark
assign [app_id="firefox"] workspace $browser
assign [app_id="foot"] workspace $terminal
for_window [app_id="org.autobutler.quark"] fullscreen enable
focus_on_window_activation focus
for_window [app_id="^(?!org\.autobutler\.quark$)"] inhibit_idle fullscreen
for_window [shell="xwayland"] inhibit_idle fullscreen

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK

# Respawn Quark; after repeated crashes, say so instead of leaving an empty desktop.
exec quark-de-respawn $quark
exec firefox
exec foot
exec quark-de-hint --first-login
exec swayidle -w timeout 300 'swaylock -f' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'swaylock -f'
exec wl-paste --watch quark-de-clipboard store
exec mako --config $share/mako/config
exec quark-de-autostart

# The first workspace bound below is the one sway starts on.
bindsym $mod+1 workspace $quark
bindsym $mod+2 exec quark-de-focus $browser firefox firefox
bindsym $mod+3 exec quark-de-focus $terminal foot foot
bindsym $mod+Tab workspace $quark
bindsym $mod+slash exec quark-de-hint
bindsym $mod+F1 exec quark-de-hint
bindsym $mod+l exec swaylock -f
bindsym $mod+v exec quark-de-clipboard pick
bindsym $mod+n exec makoctl dismiss
bindsym $mod+Shift+n exec makoctl restore
bindsym $mod+d exec quark-de-dnd
bindsym Print exec quark-de-screenshot full
bindsym Shift+Print exec quark-de-screenshot region
bindsym $mod+Print exec quark-de-screenshot window
bindsym $mod+Shift+e exec swaynag -t warning -m 'Log out of Quark?' -B 'Log out' 'swaymsg exit'

bindsym --locked XF86AudioRaiseVolume exec quark-de-osd volume-up
bindsym --locked XF86AudioLowerVolume exec quark-de-osd volume-down
bindsym --locked XF86AudioMute exec quark-de-osd mute
bindsym --locked XF86AudioMicMute exec quark-de-osd mic-mute
bindsym --locked XF86MonBrightnessUp exec quark-de-osd brightness-up
bindsym --locked XF86MonBrightnessDown exec quark-de-osd brightness-down
bindsym --locked XF86AudioPlay exec quark-de-osd play-pause
bindsym --locked XF86AudioPause exec quark-de-osd pause
bindsym --locked XF86AudioNext exec quark-de-osd next
bindsym --locked XF86AudioPrev exec quark-de-osd previous

# Distro snippets (systemd/D-Bus environment, xdg-desktop-portal for file dialogs).
include /etc/sway/config.d/*
