#!/bin/sh
# Start the Quark desktop session: sway with Quark as the desktop.
set -eu

share="$(cd "$(dirname "$0")/.." && pwd)/share/quark-de/sway"
readonly config="$share/config"
readonly fallback="$share/fallback"

usage() {
	cat <<USAGE
Usage: quark-de [--check | --report | -h]

Start the Quark desktop session (sway, with Quark as the desktop).
Usually started by a display manager: pick "Quark" at the login screen.

  --check   (or doctor) list missing dependencies and how to install them
  --report  bundle logs and session state into a local tarball and print its path
  -h        show this help
USAGE
}

# hint <command>: how to get it.
hint() {
	case "$1" in
	sway | foot | firefox | swayidle | swaylock | xdg-desktop-portal*) echo "sudo apt install $1" ;;
	wl-paste) echo "sudo apt install wl-clipboard (optional: clipboard history)" ;;
	cliphist) echo "sudo apt install cliphist (optional: clipboard history)" ;;
	wofi) echo "sudo apt install wofi (optional: Super+V clipboard picker)" ;;
	mako) echo "sudo apt install mako-notifier (no notifications without it)" ;;
	grim | slurp) echo "sudo apt install $1 (screenshot keys stay dead without it)" ;;
	wl-copy) echo "sudo apt install wl-clipboard (screenshots are saved but not copied without it)" ;;
	dex) echo "sudo apt install dex (starts your autostart apps when systemd's xdg-desktop-autostart.target is unavailable)" ;;
	quark) echo "install the Quark Linux app from https://github.com/autobutler-org/quark/releases and put 'quark' on PATH" ;;
	wpctl) echo "sudo apt install wireplumber (volume keys stay dead without it)" ;;
	brightnessctl) echo "sudo apt install brightnessctl (brightness keys stay dead without it)" ;;
	playerctl) echo "sudo apt install playerctl (play, pause, next and previous keys stay dead without it)" ;;
	notify-send) echo "sudo apt install libnotify-bin (keys work, but no on-screen level)" ;;
	polkit-agent) echo "sudo apt install lxpolkit (without a polkit agent, mounting disks and other admin actions fail without a password prompt)" ;;
	esac
}

browser() {
	if ! command -v firefox >/dev/null 2>&1 && command -v firefox-esr >/dev/null 2>&1; then
		echo firefox-esr
	else
		echo firefox
	fi
}

warn_optional() {
	for cmd in mako wpctl brightnessctl playerctl notify-send wl-paste cliphist wofi grim slurp wl-copy dex; do
		if command -v "$cmd" >/dev/null 2>&1; then
			echo "ok       $cmd"
		else
			echo "warning  $cmd — $(hint "$cmd")"
		fi
	done
	if "$(dirname "$0")/quark-de-polkit" --find >/dev/null 2>&1; then
		echo "ok       polkit-agent"
	else
		echo "warning  polkit-agent — $(hint polkit-agent)"
	fi
}

# check <command>...: report missing commands; fail if any are missing.
check() {
	missing=0
	for cmd in "$@"; do
		if command -v "$cmd" >/dev/null 2>&1; then
			echo "ok       $cmd"
		else
			echo "missing  $cmd — $(hint "$cmd")"
			missing=1
		fi
	done
	if [ ! -r "$config" ]; then
		echo "missing  $config — run 'make install' from the quark-de repository"
		missing=1
	fi
	return "$missing"
}

log_dir() {
	echo "${XDG_STATE_HOME:-${HOME:-}/.local/state}/quark-de"
}

log() {
	echo "quark-de: $*" >&2
	{ mkdir -p "$(log_dir)" && echo "$(date '+%Y-%m-%dT%H:%M:%S%z') $*" >>"$(log_dir)/session.log"; } 2>/dev/null || :
	if command -v logger >/dev/null 2>&1; then
		logger -t quark-de "$*" || :
	fi
}

check_runtime_dir() {
	dir="${XDG_RUNTIME_DIR:-}"
	if [ -z "$dir" ]; then
		log "error: XDG_RUNTIME_DIR is not set, so sway cannot start — log in through the display manager (or a TTY login with systemd-logind and pam_systemd), not su or sudo, then try again."
		exit 1
	fi
	if [ ! -d "$dir" ]; then
		log "error: XDG_RUNTIME_DIR=$dir does not exist, so sway cannot start — log out and log in again so systemd-logind creates it."
		exit 1
	fi
	# shellcheck disable=SC2012,SC2046
	set -- $(ls -ldn "$dir")
	if [ "$3" != "$(id -u)" ]; then
		log "error: XDG_RUNTIME_DIR=$dir belongs to uid $3, not you (uid $(id -u)), so sway cannot start — log in as yourself through the display manager instead of su or sudo, then try again."
		exit 1
	fi
	case "$1" in
	drwx------*) ;;
	*)
		log "error: XDG_RUNTIME_DIR=$dir has mode $1, not 0700, so sway refuses it — run 'chmod 0700 $dir', then log in again."
		exit 1
		;;
	esac
}

need_file() {
	if [ ! -r "$1" ]; then
		log "error: $1 is missing — run 'make install' from the quark-de repository, then log in again."
		exit 1
	fi
}

portal_file() {
	case "$1" in
	xdg-desktop-portal) echo dbus-1/services/org.freedesktop.portal.Desktop.service ;;
	*) echo "xdg-desktop-portal/portals/${1#xdg-desktop-portal-}.portal" ;;
	esac
}

check_portals() {
	for portal in xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk; do
		found=
		IFS=:
		for dir in ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
			[ -e "$dir/$(portal_file "$portal")" ] && found=1
		done
		unset IFS
		if [ -n "$found" ]; then
			echo "ok       $portal"
		else
			echo "warn     $portal — $(hint "$portal") (file dialogs and screen sharing need it)"
		fi
	done
}

case "${1:-}" in
-h | --help)
	usage
	exit 0
	;;
--check | doctor)
	warn_optional
	check_portals
	check sway quark foot "$(browser)" swayidle swaylock
	exit
	;;
--report)
	exec "$(dirname "$0")/quark-de-report"
	;;
"") ;;
*)
	echo "quark-de: unknown argument '$1'" >&2
	usage >&2
	exit 2
	;;
esac

for cmd in foot "$(browser)"; do
	command -v "$cmd" >/dev/null 2>&1 || log "warning: $cmd is missing, so its workspace stays empty — $(hint "$cmd")"
done

if ! command -v sway >/dev/null 2>&1; then
	log "error: sway is missing — $(hint sway), then log in again. 'quark-de --check' lists everything missing."
	exit 1
fi
warn_optional | grep '^warning' >&2 || :
check_runtime_dir

if ! command -v quark >/dev/null 2>&1; then
	need_file "$fallback"
	QUARK_DE_ERROR="Quark is missing: $(hint quark), then log out and log in again. Details: $(log_dir)/session.log"
	export QUARK_DE_ERROR
	log "error: $QUARK_DE_ERROR"
	exec sway --config "$fallback"
fi

need_file "$config"
export XDG_CURRENT_DESKTOP=Quark:sway XDG_SESSION_DESKTOP=quark-de
exec sway --config "$config"
