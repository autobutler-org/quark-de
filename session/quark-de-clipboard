#!/bin/sh
set -eu

readonly password_hint=x-kde-passwordManagerHint
readonly picker_items=20

usage() {
	cat <<USAGE
Usage: quark-de-clipboard store | pick

  store   save the clipboard on stdin to the cliphist history, unless a
          password manager marked it ($password_hint)
  pick    choose one of the last $picker_items clipboard items with wofi and copy it
USAGE
}

secret_offered() {
	wl-paste --list-types 2>/dev/null | grep -qx "$password_hint"
}

store() {
	copy="$(mktemp)"
	trap 'rm -f "$copy"' EXIT
	cat >"$copy"
	secret_offered && exit 0
	wl-paste --no-newline 2>/dev/null | cmp -s - "$copy" || exit 0
	secret_offered && exit 0
	cliphist store <"$copy"
}

pick() {
	if ! command -v wofi >/dev/null 2>&1; then
		swaynag -t warning -m 'The clipboard picker needs wofi: sudo apt install wofi'
		exit 1
	fi
	choice="$(cliphist list | head -n "$picker_items" | wofi --dmenu --prompt clipboard)" || exit 0
	printf '%s\n' "$choice" | cliphist decode | wl-copy
}

case "${1:-}" in
store) store ;;
pick) pick ;;
-h | --help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
