#!/bin/sh
set -eu

if [ "$#" -lt 3 ]; then
	echo "Usage: quark-de-focus <workspace> <app_id> <command> [args...]" >&2
	echo "Switches to <workspace> and focuses <app_id>, starting <command> if no <app_id> window exists." >&2
	exit 2
fi

readonly workspace="$1" app_id="$2"
shift 2

swaymsg -q workspace "$workspace"
if ! swaymsg -q "[app_id=\"^$app_id\$\"] focus" 2>/dev/null; then
	exec "$@"
fi
